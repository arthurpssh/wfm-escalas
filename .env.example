# Copie para .env (arquivo ignorado pelo git) e preencha. Só para uso LOCAL.
# Em produção as variáveis vêm do values.yml (secretKeyRef), nunca de um arquivo .env.

# --- Origem dos dados: mock (padrão, dados de exemplo) | sheets (planilha real, somente leitura) ---
DATA_SOURCE=mock
PORT=3000

# --- Só com DATA_SOURCE=sheets ---
SHEETS_SPREADSHEET_ID=
# Conta de serviço (um valor para cada secret). A chave pode ter "\n" literal, entre aspas duplas.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=""
SHEETS_CACHE_SEC=60
# 1 = o app grava rascunhos, gerador e histórico na planilha (a conta de serviço precisa ser Editor). 0 = somente leitura.
SHEETS_WRITE=0
# OPCIONAL. Sem isso (padrão) os CSVs do checkout ficam na aba Arquivos da própria planilha.
# Só use se tiver uma pasta numa UNIDADE COMPARTILHADA com a conta de serviço como membro (no Meu Drive dá erro de cota).
DRIVE_FOLDER_ID=

# --- Quem pode entrar ---
# O modo é definido na ABA CONFIG da planilha (linha access_mode: open | restricted), sem redeploy e fora dos secrets.
# ACCESS_MODE só vale como PADRÃO quando a Config não define access_mode (e no mock, que não tem planilha).
# open (padrão): todo usuário autenticado abre o app e vê todos os times em leitura; a aba Acessos só dá edição/admin.
# restricted: só entra quem tem uma linha válida na aba Acessos (qualquer papel, inclusive viewer).
ACCESS_MODE=open

# --- Identidade ---
# Mock: seletor "entrar como..." na tela. Com dados reais, use MOCK_AUTH=0 e DEV_USER_EMAIL.
MOCK_AUTH=1
# Só desenvolvimento local; NUNCA em produção (em produção vale o cabeçalho do proxy).
DEV_USER_EMAIL=
IDENTITY_HEADER=x-auth-request-email
DEV_IMPERSONATE=1

# --- Comportamento do mock (opcionais) ---
GRACE_MIN=2
CONSOLIDATE_AFTER_SEC=0
# CSV_GAP_DAYS=
